# Copie para .env e preencha com valores locais. Não versione o .env.
# Nenhum valor real de segredo deve ser escrito neste arquivo de exemplo.

# Obrigatório quando APP_ENV=production. Em desenvolvimento, uma chave efêmera
# é gerada no boot. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# development | production
APP_ENV=development

# true habilita o debugger do Werkzeug. Nunca use true em produção.
FLASK_DEBUG=false

# Caminho do arquivo SQLite.
DATABASE_PATH=loja.db

# Cria o schema e insere os dados de exemplo no boot quando o banco está vazio.
AUTO_INIT_DB=true

HOST=127.0.0.1
PORT=5000

# Origens permitidas para CORS, separadas por vírgula. Vazio desabilita CORS.
CORS_ORIGINS=

# Endpoints administrativos. Desligados por padrão; exigem token quando ligados.
ADMIN_API_ENABLED=false
ADMIN_API_TOKEN=

LOG_LEVEL=INFO
